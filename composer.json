{
    "name": "youvision/think-paginate",
    "description": "ThinkPHP 8 分页扩展，内置 Layui、Bootstrap 6 分页驱动",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "thinkphp",
        "thinkphp8",
        "paginate",
        "pagination",
        "layui",
        "bootstrap"
    ],
    "authors": [
        {
            "name": "youvision"
        }
    ],
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkPaginate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Youvision\\ThinkPaginate\\Tests\\": "tests/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkPaginate\\PaginateService"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}